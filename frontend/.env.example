# Copy to .env.local for a local build against a tunnel, or set the same name in the Cloudflare Pages / GitHub settings.
# Read at BUILD time and compiled into the public JavaScript, so anyone who can open the dashboard can read this URL.
# Leave it unset for the normal local setup (the API is then found automatically).
NEXT_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
